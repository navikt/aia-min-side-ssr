{
  "name": "aia-min-side-ssr",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "SIDE_2_URL=https://www.ansatt.dev.nav.no/arbeidssoekerregisteret astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "mock": "tsx mock/server.ts",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "test": "pnpm run lint && vitest dev",
    "test:ci": "vitest run",
    "prepare": "husky",
    "refresh": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm i --ignore-scripts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/node": "11.0.0",
    "@astrojs/react": "6.0.0",
    "@navikt/aksel-icons": "8.14.0",
    "@navikt/arbeidssokerregisteret-utils": "2.1.0",
    "@navikt/ds-css": "8.14.0",
    "@navikt/ds-react": "8.14.0",
    "@navikt/oasis": "4.1.4",
    "astro": "7.0.3",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@chromatic-com/storybook": "5.2.1",
    "@hono/node-server": "2.0.6",
    "@navikt/ds-tailwind": "8.14.0",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-onboarding": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.1.9",
    "hono": "4.12.27",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.24.0",
    "lint-staged": "17.0.8",
    "playwright": "1.61.1",
    "postcss": "8.5.16",
    "postcss-prefix-selector": "2.1.1",
    "storybook": "10.4.6",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
