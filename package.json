{
  "name": "aia-min-side-ssr",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "SIDE_2_URL=https://www.ansatt.dev.nav.no/arbeidssoekerregisteret astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "mock": "tsx mock/server.ts",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "test": "npm run lint && vitest dev",
    "test:ci": "vitest run",
    "prepare": "husky",
    "refresh": "rm -rf node_modules && rm package-lock.json && npm i --ignore-scripts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/node": "9.5.1",
    "@astrojs/react": "4.4.2",
    "@navikt/aksel-icons": "7.35.1",
    "@navikt/arbeidssokerregisteret-utils": "1.8.3",
    "@navikt/ds-css": "7.35.1",
    "@navikt/ds-react": "7.35.1",
    "@navikt/nav-dekoratoren-moduler": "3.2.3",
    "@navikt/oasis": "4.1.1",
    "@opentelemetry/sdk-node": "0.208.0",
    "astro": "5.16.4",
    "pino": "10.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rollup-plugin-import-map": "3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@chromatic-com/storybook": "4.1.3",
    "@hono/node-server": "1.19.7",
    "@navikt/ds-tailwind": "7.35.1",
    "@storybook/addon-a11y": "10.1.5",
    "@storybook/addon-docs": "10.1.5",
    "@storybook/addon-onboarding": "10.1.5",
    "@storybook/addon-vitest": "10.1.5",
    "@storybook/react-vite": "10.1.5",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.0.15",
    "@vitest/coverage-v8": "4.0.15",
    "hono": "4.10.8",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "playwright": "1.57.0",
    "postcss": "8.5.6",
    "postcss-prefix-selector": "2.1.1",
    "storybook": "10.1.5",
    "tailwindcss": "4.1.17",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=24.11.1"
  }
}
