{
  "name": "aia-min-side-ssr",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "SIDE_2_URL=https://www.ansatt.dev.nav.no/arbeidssoekerregisteret astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "mock": "tsx mock/server.ts",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "test": "pnpm run lint && vitest dev",
    "test:ci": "vitest run",
    "prepare": "husky",
    "refresh": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm i --ignore-scripts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/node": "10.1.1",
    "@astrojs/react": "5.0.5",
    "@navikt/aksel-icons": "8.11.0",
    "@navikt/arbeidssokerregisteret-utils": "2.1.0",
    "@navikt/ds-css": "8.11.0",
    "@navikt/ds-react": "8.11.0",
    "@navikt/oasis": "4.1.4",
    "astro": "6.3.7",
    "pino": "10.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@chromatic-com/storybook": "5.2.1",
    "@hono/node-server": "2.0.4",
    "@navikt/ds-tailwind": "8.11.0",
    "@storybook/addon-a11y": "10.4.1",
    "@storybook/addon-docs": "10.4.1",
    "@storybook/addon-onboarding": "10.4.1",
    "@storybook/addon-vitest": "10.4.1",
    "@storybook/react-vite": "10.4.1",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.1.7",
    "hono": "4.12.21",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.14.1",
    "lint-staged": "17.0.5",
    "playwright": "1.60.0",
    "postcss": "8.5.15",
    "postcss-prefix-selector": "2.1.1",
    "storybook": "10.4.1",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.5": ">=5.0.5",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "js-cookie@<=3.0.5": ">=3.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "picomatch@<2.3.2": ">=2.3.2",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
    }
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
