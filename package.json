{
  "name": "aia-min-side-ssr",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "SIDE_2_URL=https://www.ansatt.dev.nav.no/arbeidssoekerregisteret astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "mock": "tsx mock/server.ts",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "test": "pnpm run lint && vitest dev",
    "test:ci": "vitest run",
    "prepare": "husky",
    "refresh": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm i --ignore-scripts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "6.0.5",
    "@navikt/aksel-icons": "8.16.2",
    "@navikt/arbeidssokerregisteret-utils": "2.1.0",
    "@navikt/ds-css": "8.16.2",
    "@navikt/ds-react": "8.16.2",
    "@navikt/oasis": "4.2.2",
    "astro": "7.3.2",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@chromatic-com/storybook": "5.3.1",
    "@hono/node-server": "2.1.1",
    "@navikt/ds-tailwind": "8.16.2",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-onboarding": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser": "4.1.11",
    "hono": "4.13.7",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.35.1",
    "lint-staged": "17.5.1",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "postcss-prefix-selector": "2.2.1",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
