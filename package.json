{
  "name": "aia-min-side-ssr",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "SIDE_2_URL=https://www.ansatt.dev.nav.no/arbeidssoekerregisteret astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "mock": "tsx mock/server.ts",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check",
    "lint:ci": "biome ci",
    "test": "pnpm run lint && vitest dev",
    "test:ci": "vitest run",
    "prepare": "husky",
    "refresh": "rm -rf node_modules && rm pnpm-lock.yaml && pnpm i --ignore-scripts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/node": "10.0.4",
    "@astrojs/react": "5.0.3",
    "@navikt/aksel-icons": "8.9.1",
    "@navikt/arbeidssokerregisteret-utils": "2.1.0",
    "@navikt/ds-css": "8.9.1",
    "@navikt/ds-react": "8.9.1",
    "@navikt/nav-dekoratoren-moduler": "3.7.1",
    "@navikt/oasis": "4.1.4",
    "@opentelemetry/sdk-node": "0.214.0",
    "astro": "6.1.6",
    "pino": "10.3.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@chromatic-com/storybook": "5.1.2",
    "@hono/node-server": "1.19.14",
    "@navikt/ds-tailwind": "8.9.1",
    "@storybook/addon-a11y": "10.3.5",
    "@storybook/addon-docs": "10.3.5",
    "@storybook/addon-onboarding": "10.3.5",
    "@storybook/addon-vitest": "10.3.5",
    "@storybook/react-vite": "10.3.5",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser": "4.1.4",
    "hono": "4.12.12",
    "husky": "9.1.7",
    "jsdom": "29.0.2",
    "knip": "6.4.1",
    "lint-staged": "16.4.0",
    "playwright": "1.59.1",
    "postcss": "8.5.9",
    "postcss-prefix-selector": "2.1.1",
    "storybook": "10.3.5",
    "tailwindcss": "4.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome format --write --no-errors-on-unmatched",
      "biome lint --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
