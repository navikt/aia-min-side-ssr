---
import {
  ARBEIDSSOEKERPERIODER_AGGREGERT_URL,
  ARBEIDSSOKERREGISTERET_OPPSLAG_CLIENT_ID,
  BEKREFTELSE_API_CLIENT_ID,
  SIDE_2_URL,
  TILGJENGELIGE_BEKREFTELSER_URL,
} from 'astro:env/server';
import type { Language } from '@src/language/types';
import '@src/styles/index.css';
import type { AggregertePerioder, TilgjengeligeBekreftelser } from '@navikt/arbeidssokerregisteret-utils';
import AiA from '@src/components/aia';
import LoggVisning from '@src/components/logg-visning';
import { fetchData } from '@src/utils/fetch';
import { logger } from '@src/utils/logger';
import { getOboToken } from '@src/utils/token';
import { isLocal } from '../../utils/environment';

let _aggregertePerioder: AggregertePerioder, _tilgjengeligeBekreftelser: TilgjengeligeBekreftelser[];
try {
  _aggregertePerioder = await fetchData(
    ARBEIDSSOEKERPERIODER_AGGREGERT_URL,
    await getOboToken(Astro.locals.token, ARBEIDSSOKERREGISTERET_OPPSLAG_CLIENT_ID),
  );
  _tilgjengeligeBekreftelser = await fetchData(
    TILGJENGELIGE_BEKREFTELSER_URL,
    await getOboToken(Astro.locals.token, BEKREFTELSE_API_CLIENT_ID),
  );
} catch (error) {
  logger.error(error, `Error fetching data: ${error}`);
  return new Response('Internal Server Error', { status: 503 });
}
const _language = Astro.currentLocale as Language;
---

{isLocal && <meta charset="UTF-8" />}
<section class="aia-min-side-ssr">
  <AiA
    side2Url={SIDE_2_URL}
    aggregertPeriode={_aggregertePerioder[0]}
    tilgjengeligeBekreftelser={_tilgjengeligeBekreftelser}
    sprak={_language}
    client:load
  />
  <LoggVisning
    aggregertPeriode={_aggregertePerioder[0]}
    tilgjengeligeBekreftelser={_tilgjengeligeBekreftelser}
    client:load
  />
</section>
